# ===================================================
# Python & Virtual Environments
# ===================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
.venv/
venv/
env/
ENV/

# ===================================================
# Dokumen Biner & Presentasi (Word, PowerPoint, Excel, PDF)
# ===================================================
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls
*.pdf
~$*
Caca/

# Dokumen biner di dalam subfolder
dokumen/*.docx
dokumen/*.doc
dokumen/*.pptx
dokumen/*.xlsx
dokumen/*.pdf
!dokumen/*.md

# ===================================================
# Reports, Logs & Temporary Files
# ===================================================
reports/*
!reports/.gitkeep
*.log
*.tmp
*.bak

# ===================================================
# Archives & Bundles
# ===================================================
*.zip
*.tar.gz
*.rar
*.7z

# ===================================================
# IDE, OS & Editor Artifacts
# ===================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ===================================================
# Local Secrets & Environment
# ===================================================
.env
.env.*
!.env.example